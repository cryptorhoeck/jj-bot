cmd_restore(){
    ensure_venv
    msg "🔄 JJ-Bot Enterprise Restore System"
    msg ""
    msg "⚠️  WARNING: This will stop services and modify your system!"
    msg "⚠️  A backup of the current state will be created first."
    msg ""
    read -p "Continue? (y/N): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        msg "Restore cancelled"
        return
    fi
    
    cd "$PROJECT_DIR"
    
    # List available backups
    python3 -c "
import sys; sys.path.append('.')
from ops.backup.enterprise_backup_manager import backup_manager
backups = backup_manager.list_backups()
print('Available backups:')
for i, backup in enumerate(backups[:10]):
    print(f'  {i+1}. {backup[\"type\"].upper()}: {backup[\"name\"]} - {backup[\"size_human\"]} ({backup[\"timestamp\"]})')
"
    
    echo ""
    read -p "Enter backup number to restore from: " backup_num
    
    python3 -c "
import sys; sys.path.append('.')
from ops.backup.enterprise_backup_manager import backup_manager
from ops.restore.enterprise_restore_manager import restore_manager
import asyncio

backups = backup_manager.list_backups()
backup_num = int('$backup_num') - 1

if 0 <= backup_num < len(backups):
    backup = backups[backup_num]
    print(f'Restoring from: {backup[\"name\"]}')
    
    result = restore_manager.restore_from_backup(backup['id'])
    
    if result['status'] == 'completed':
        print(f'✅ Restore completed successfully!')
        print(f'   Duration: {result.get(\"duration\", 0):.1f} seconds')
        print(f'   Steps: {len(result.get(\"steps_completed\", []))}')
    else:
        print(f'❌ Restore failed: {result.get(\"error\", \"Unknown error\")}')
else:
    print('❌ Invalid backup number')
"
}

