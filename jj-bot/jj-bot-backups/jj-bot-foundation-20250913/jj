    ensure_venv
    msg "🔴 Starting LIVE trading with real market data..."
    msg "⚠️  WARNING: This uses real market data from Binance"
    msg "💡 This is still SIMULATION - no actual money at risk"
    msg ""
    read -p "Continue? (y/N): " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        cd "$PROJECT_DIR"
        python3 glue/api/live_trader.py
    else
        msg "Live trading cancelled"
    fi
}

