#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$HOME/jj-bot"
VENV_DIR="$PROJECT_DIR/.venv"
LOG_DIR="$PROJECT_DIR/ops/logs"
DASH_DIR="$PROJECT_DIR/dashboard/jj-dashboard"

msg(){ echo -e "$1"; }

ensure_venv(){
    if [[ -z "${VIRTUAL_ENV:-}" || "$VIRTUAL_ENV" != "$VENV_DIR" ]]; then
        if [[ ! -d "$VENV_DIR" ]]; then
            msg "🧪 Creating Python venv..."
            python3 -m venv "$VENV_DIR"
        fi
        source "$VENV_DIR/bin/activate"
        python3 -V >/dev/null
        pip -q install --upgrade pip >/dev/null
        [[ -f "$PROJECT_DIR/requirements.txt" ]] && pip -q install -r "$PROJECT_DIR/requirements.txt" || true
        msg "(.venv) ACTIVE: $VENV_DIR"
    fi
}

ensure_logs(){
    mkdir -p "$LOG_DIR"
    touch "$LOG_DIR/glue.log"
}

# Function definitions for different commands
cmd_reset(){
    ensure_venv
    ensure_logs
    
    msg "🏗️ Building dashboard..."
    if [[ -d "$DASH_DIR" ]]; then
        pushd "$DASH_DIR" >/dev/null
        npm run build >/dev/null 2>&1 || msg "⚠️ Dashboard build warning (continuing...)"
        popd >/dev/null
    fi
    
    # Create backup
    local backup_file="$PROJECT_DIR/../jj-bot-backup-$(date +%Y%m%d_%H%M%S).tar.gz"
    tar -czf "$backup_file" -C "$PROJECT_DIR" . 2>/dev/null || true
    msg "💾 Creating backup: $backup_file"
    
    # Keep only latest 5 backups
    ls -t "$PROJECT_DIR"/../jj-bot-backup-*.tar.gz 2>/dev/null | tail -n +6 | xargs -r rm
    msg "✅ Backup complete (kept latest 5)"
    
    msg "🧹 Resetting Glue API..."
    pkill -f "uvicorn.*main:app" 2>/dev/null || true
    sleep 2
    
    # Start API server
    cd "$PROJECT_DIR"
    nohup uvicorn glue.api.main:app --host 0.0.0.0 --port 8000 --reload > "$LOG_DIR/glue.log" 2>&1 &
    sleep 3
    
    # Test API
    if curl -s http://127.0.0.1:8000/health >/dev/null 2>&1; then
        msg "✅ API server started successfully"
        msg "🌐 Dashboard: http://127.0.0.1:8000/dashboard/"
    else
        msg "❌ API not responding. Check logs with: jj logs"
    fi
}

cmd_stop(){
    ensure_venv
    msg "🛑 Stopping Glue API..."
    pkill -f "uvicorn.*main:app" 2>/dev/null || true
    pkill -f "sim_trader" 2>/dev/null || true
}

cmd_logs(){
    ensure_logs
    msg "📜 Tailing logs (Ctrl+C to stop)..."
    tail -f "$LOG_DIR/glue.log"
}

cmd_status(){
    ensure_logs
    msg "📊 JJ-Bot Status:"
    
    # Check API process
    if pgrep -f "uvicorn.*main:app" >/dev/null; then
        msg "✅ API: Running (PID: $(pgrep -f 'uvicorn.*main:app'))"
    else
        msg "❌ API: Not running"
    fi
    
    # Check API health
    if curl -s http://127.0.0.1:8000/health >/dev/null 2>&1; then
        msg "✅ Health: API responding"
    else
        msg "❌ Health: API not responding"
    fi
    
    # Show recent logs
    if [[ -f "$LOG_DIR/glue.log" ]]; then
        msg "📜 Recent logs:"
        tail -5 "$LOG_DIR/glue.log"
    fi
}

cmd_trade(){
    ensure_venv
    msg "🤖 Starting trade simulator..."
    msg "Choose simulator:"
    msg "  1. Basic simulator"
    msg "  2. Advanced multi-strategy simulator"
    read -p "Enter choice (1 or 2): " choice
    cd "$PROJECT_DIR"
    if [[ "$choice" == "2" ]]; then
        python3 glue/api/advanced_sim_trader.py
    else
        python3 glue/api/sim_trader.py
    fi
}

# Main command router
case "${1:-}" in
    reset)    cmd_reset ;;
    stop)     cmd_stop ;;
    logs)     cmd_logs ;;
    status)   cmd_status ;;
    trade)    cmd_trade ;;
    *)
        msg "JJ-Bot commands:
  jj reset  -- Backup + build dashboard + restart API  
  jj stop   -- Stop API
  jj logs   -- Tail API logs
  jj status -- Show processes, logs, backups
  jj trade  -- Run trade simulator
  jj live   -- Run LIVE trading with real data
  jj alerts -- Notification management
  jj master -- Start all services (master control)
  jj test   -- Run comprehensive system test
  jj backup -- Enterprise backup management
  jj restore -- Enterprise restore system
  jj enterprise -- Enterprise platform control"
        ;;
esac

