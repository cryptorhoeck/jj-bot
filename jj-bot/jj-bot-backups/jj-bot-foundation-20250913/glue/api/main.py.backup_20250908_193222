@app.get("/api/admin/logs/{log_type}")
def get_logs_admin(log_type: str, lines: int = 100):
    """Get system logs for admin interface"""
    try:
        log_dir = Path.home() / "jj-bot" / "ops" / "logs"
        log_files = {
            "api": "glue.log",
            "backup": "backup.log", 
            "restore": "restore.log",
            "system": "system_monitor.log"
        }
        
        if log_type not in log_files:
            return {"success": False, "error": f"Unknown log type: {log_type}"}
        
        log_file = log_dir / log_files[log_type]
        
        if not log_file.exists():
            return {"success": True, "logs": [], "message": f"Log file {log_type} does not exist yet"}
        
        # Read last N lines
        with open(log_file, 'r') as f:
            all_lines = f.readlines()
            recent_lines = all_lines[-lines:] if len(all_lines) > lines else all_lines
        
        return {
            "success": True, 
            "logs": [line.strip() for line in recent_lines],
            "total_lines": len(all_lines),
            "showing_lines": len(recent_lines)
        }
    except Exception as e:
        return {"success": False, "error": str(e)}

@app.get("/api/admin/database/stats")
def get_database_stats():
    """Get database statistics for admin interface"""
    try:
        db_path = Path.home() / "jj-bot" / "data" / "trades.db"
        
        if not db_path.exists():
            return {"success": False, "error": "Database not found"}
        
        stats = {}
        
        with sqlite3.connect(db_path) as conn:
            cursor = conn.cursor()
            
            # Get table info
            cursor.execute("SELECT name FROM sqlite_master WHERE type='table'")
            tables = [row[0] for row in cursor.fetchall()]
            stats['tables'] = tables
            
            # Get trades statistics
            if 'trades' in tables:
                cursor.execute("SELECT COUNT(*) FROM trades")
                stats['total_trades'] = cursor.fetchone()[0]
                
                cursor.execute("SELECT MIN(timestamp), MAX(timestamp) FROM trades")
                date_range = cursor.fetchone()
                stats['date_range'] = {
                    'earliest': date_range[0],
                    'latest': date_range[1]
                }
                
                cursor.execute("SELECT AVG(pnl), SUM(pnl) FROM trades")
                pnl_stats = cursor.fetchone()
                stats['pnl_stats'] = {
                    'average': pnl_stats[0],
                    'total': pnl_stats[1]
                }
                
                cursor.execute("SELECT signal, COUNT(*) FROM trades GROUP BY signal")
                signal_counts = {row[0]: row[1] for row in cursor.fetchall()}
                stats['signal_distribution'] = signal_counts
        
        # Get database file size
        stats['file_size_bytes'] = db_path.stat().st_size
        stats['file_size_human'] = _format_bytes(stats['file_size_bytes'])
        
        return {"success": True, "stats": stats}
        
    except Exception as e:
        return {"success": False, "error": str(e)}

