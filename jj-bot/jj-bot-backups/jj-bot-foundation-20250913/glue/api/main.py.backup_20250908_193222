@app.post("/api/admin/config/save")
async def save_config_admin(config_data: Dict[str, Any]):
    """Save configuration file"""
    try:
        project_root = Path.home() / "jj-bot"
        config_file = config_data.get('file')
        config_content = config_data.get('content')
        
        if not config_file or config_content is None:
            return {"success": False, "error": "file and content are required"}
        
        config_path = project_root / config_file
        config_path.parent.mkdir(parents=True, exist_ok=True)
        
        # Backup current config
        if config_path.exists():
            backup_path = config_path.with_suffix(f".backup.{datetime.datetime.now().strftime('%Y%m%d_%H%M%S')}")
            shutil.copy2(config_path, backup_path)
        
        # Save new config
        if config_path.suffix == '.json' and isinstance(config_content, dict):
            with open(config_path, 'w') as f:
                json.dump(config_content, f, indent=2)
        else:
            with open(config_path, 'w') as f:
                f.write(str(config_content))
        
        return {"success": True, "message": f"Configuration {config_file} saved successfully"}
    except Exception as e:
        return {"success": False, "error": str(e)}

@app.post("/api/admin/service/restart")
async def restart_service_admin(service_data: Dict[str, Any]):
    """Restart specific service"""
    try:
        service_name = service_data.get('service')
        
        if service_name == 'api':
            # Restart API server
            os.system("pkill -f 'uvicorn.*main:app' 2>/dev/null || true")
            await asyncio.sleep(2)
            
            # Start new instance
            restart_cmd = """
            cd ~/jj-bot
            source .venv/bin/activate
            nohup uvicorn glue.api.main:app --host 0.0.0.0 --port 8000 --reload > ops/logs/glue.log 2>&1 &
            """
            os.system(restart_cmd)
            
            return {"success": True, "message": "API service restarted"}
        
        elif service_name == 'all':
            # Restart all services
            os.system("cd ~/jj-bot && ./jj stop")
            await asyncio.sleep(3)
            os.system("cd ~/jj-bot && ./jj reset")
            
            return {"success": True, "message": "All services restarted"}
        
        else:
            return {"success": False, "error": f"Unknown service: {service_name}"}
            
    except Exception as e:
        return {"success": False, "error": str(e)}

