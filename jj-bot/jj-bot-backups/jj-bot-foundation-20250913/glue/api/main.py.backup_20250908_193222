# ---- helpers ----
def safe_float(x):
    try:
        f = float(x)
        if math.isfinite(f):
            return f
        return None
    except Exception:
        return None

def safe_record(rec: Dict[str, Any]) -> Dict[str, Any]:
    out = {}
    for k, v in rec.items():
        if isinstance(v, float):
            out[k] = safe_float(v)
        elif isinstance(v, dict):
            out[k] = safe_record(v)
        else:
            out[k] = v
    return out

