{
  "retention": {
    "hourly": 24,
    "daily": 30,
    "weekly": 12,
    "monthly": 12
  },
  "schedule": {
    "hourly": "0 * * * *",
    "daily": "0 2 * * *",
    "weekly": "0 3 * * 0",
    "monthly": "0 4 1 * *"
  },
  "compression": true,
  "encryption": false,
  "verify_backups": true,
  "cleanup_old_backups": true,
  "backup_locations": {
    "local": "/home/ren/jj-bot-enterprise-backups",
    "remote": null
  },
  "exclude_patterns": [
    "*.pyc",
    "__pycache__",
    ".git",
    "node_modules",
    ".venv",
    "*.log",
    "dist",
    "build"
  ],
  "include_database": true,
  "include_logs": false,
  "max_backup_size_gb": 10
}