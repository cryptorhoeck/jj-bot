{% extends "base.html" %}

{% block content %}
<div x-data="devTools()" x-init="loadData()">
    <!-- System Monitoring -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
        <!-- Process Monitor -->
        <div class="bg-white rounded-lg shadow p-6">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-lg font-semibold">Process Monitor</h3>
                <button @click="loadProcesses()" class="btn-secondary text-sm">
                    <i class="fas fa-sync"></i> Refresh
                </button>
            </div>
            
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b">
                            <th class="text-left py-2">PID</th>
                            <th class="text-left py-2">Name</th>
                            <th class="text-left py-2">CPU%</th>
                            <th class="text-left py-2">Memory</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="proc in processes">
                            <tr class="border-b">
                                <td class="py-2" x-text="proc.pid"></td>
                                <td class="py-2" x-text="proc.name"></td>
                                <td class="py-2" x-text="proc.cpu_percent + '%'"></td>
                                <td class="py-2" x-text="proc.memory_mb + ' MB'"></td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Performance Chart -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold mb-4">System Performance</h3>
            <div class="space-y-4">
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span>CPU Usage</span>
                        <span x-text="performance.current.cpu.toFixed(1) + '%'"></span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="bg-blue-600 h-2 rounded-full" :style="`width: ${performance.current.cpu}%`"></div>
                    </div>
                </div>
                
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span>Memory Usage</span>
                        <span x-text="performance.current.memory.toFixed(1) + '%'"></span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="bg-green-600 h-2 rounded-full" :style="`width: ${performance.current.memory}%`"></div>
                    </div>
                </div>
                
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span>Disk Usage</span>
                        <span x-text="performance.current.disk.toFixed(1) + '%'"></span>
                    </div>
                    <div class="w-full bg-gray-200 rounded-full h-2">
                        <div class="bg-yellow-600 h-2 rounded-full" :style="`width: ${performance.current.disk}%`"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Development Utilities -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- API Testing -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold mb-4">API Testing</h3>
            <div class="space-y-3">
                <button @click="testEndpoint('/health')" class="w-full btn-secondary text-left">
                    Test Health Endpoint
                </button>
                <button @click="testEndpoint('/api/summary')" class="w-full btn-secondary text-left">
                    Test Summary API
                </button>
                <button @click="testEndpoint('/api/trades')" class="w-full btn-secondary text-left">
                    Test Trades API
                </button>
                <button @click="testEndpoint('/api/config')" class="w-full btn-secondary text-left">
                    Test Config API
                </button>
            </div>
            
            <div x-show="apiTestResult" class="mt-4 p-3 bg-gray-50 rounded text-xs">
                <pre x-text="apiTestResult"></pre>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold mb-4">Quick Actions</h3>
            <div class="space-y-3">
                <button @click="clearTradeData()" class="w-full btn-secondary text-left">
                    Clear Trade Data
                </button>
                <button @click="exportLogs()" class="w-full btn-secondary text-left">
                    Export Recent Logs
                </button>
                <button @click="systemInfo()" class="w-full btn-secondary text-left">
                    Show System Info
                </button>
                <button @click="checkDependencies()" class="w-full btn-secondary text-left">
                    Check Dependencies
                </button>
            </div>
        </div>

        <!-- Database Tools -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold mb-4">Database Tools</h3>
            <div class="space-y-3">
                <button @click="dbStats()" class="w-full btn-secondary text-left">
                    Database Statistics
                </button>
                <button @click="exportCSV()" class="w-full btn-secondary text-left">
                    Export Trade CSV
                </button>
                <button @click="backupDB()" class="w-full btn-secondary text-left">
                    Backup Database
                </button>
                <button @click="optimizeDB()" class="w-full btn-secondary text-left">
                    Optimize Database
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function devTools() {
    return {
        processes: [],
        performance: {
            current: { cpu: 0, memory: 0, disk: 0 },
            history: []
        },
        apiTestResult: '',

        async loadData() {
            await this.loadProcesses();
            await this.loadPerformance();
        },

        async loadProcesses() {
            try {
                const response = await fetch('/api/system/processes');
                const data = await response.json();
                this.processes = data.processes || [];
            } catch (error) {
                console.error('Error loading processes:', error);
            }
        },

        async loadPerformance() {
            try {
                const response = await fetch('/api/system/performance');
                const data = await response.json();
                this.performance = data;
            } catch (error) {
                console.error('Error loading performance:', error);
            }
        },

        async testEndpoint(endpoint) {
            try {
                const response = await fetch(`http://127.0.0.1:8000${endpoint}`);
                const data = await response.json();
                this.apiTestResult = JSON.stringify(data, null, 2);
            } catch (error) {
                this.apiTestResult = `Error: ${error.message}`;
            }
        },

        async clearTradeData() {
            if (!confirm('Clear all trade data? This cannot be undone.')) return;
            
            try {
                const response = await fetch('http://127.0.0.1:8000/api/data/clear', { method: 'POST' });
                const result = await response.json();
                alert(result.success ? 'Trade data cleared!' : 'Failed to clear data');
            } catch (error) {
                alert('Error: ' + error.message);
            }
        },

        async exportLogs() {
            try {
                const response = await fetch('/api/logs/live?lines=1000');
                const data = await response.json();
                
                const logText = data.logs.map(log => 
                    `${log.timestamp} [${log.level}] ${log.source}: ${log.message}`
                ).join('\n');
                
                this.downloadText(logText, 'jj-bot-logs.txt');
            } catch (error) {
                alert('Export failed: ' + error.message);
            }
        },

        async exportCSV() {
            try {
                const response = await fetch('http://127.0.0.1:8000/api/data/export');
                const data = await response.json();
                
                if (data.csv_data) {
                    this.downloadText(data.csv_data, data.filename);
                } else {
                    alert('No data to export');
                }
            } catch (error) {
                alert('Export failed: ' + error.message);
            }
        },

        downloadText(text, filename) {
            const blob = new Blob([text], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            a.click();
            window.URL.revokeObjectURL(url);
        },

        async systemInfo() {
            try {
                const response = await fetch('/api/status');
                const data = await response.json();
                this.apiTestResult = JSON.stringify(data, null, 2);
            } catch (error) {
                this.apiTestResult = `Error: ${error.message}`;
            }
        },

        async checkDependencies() {
            this.apiTestResult = 'Checking dependencies...\n\nThis feature will be implemented in Phase 3.';
        },

        async dbStats() {
            try {
                const response = await fetch('http://127.0.0.1:8000/api/summary');
                const data = await response.json();
                this.apiTestResult = `Database Statistics:\nTotal Trades: ${data.total_trades}\nToday's Trades: ${data.today_trades}\nTotal P&L: $${data.total_pnl}`;
            } catch (error) {
                this.apiTestResult = `Error: ${error.message}`;
            }
        },

        async backupDB() {
            const reason = prompt('Backup reason:');
            if (!reason) return;
            
            try {
                const formData = new FormData();
                formData.append('reason', reason);
                
                const response = await fetch('/api/backup/create', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                alert(result.success ? 'Backup created!' : 'Backup failed');
            } catch (error) {
                alert('Backup error: ' + error.message);
            }
        },

        async optimizeDB() {
            alert('Database optimization feature will be implemented in Phase 3.');
        }
    }
}

// Auto-refresh data every 30 seconds
setInterval(() => {
    if (typeof devTools !== 'undefined') {
        const app = Alpine.$data(document.querySelector('[x-data]'));
        if (app) {
            app.loadData();
        }
    }
}, 30000);
</script>
{% endblock %}
