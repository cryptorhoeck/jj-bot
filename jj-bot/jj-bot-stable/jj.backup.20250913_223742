#!/bin/bash

# JJ-Bot Command System - Fixed Version
cd ~/jj-bot
source .venv/bin/activate 2>/dev/null

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check if API is running (fixed detection)
check_api() {
    # Check both uvicorn and if port 8000 is listening
    if pgrep -f "uvicorn.*main:app" > /dev/null || netstat -tuln 2>/dev/null | grep -q ":8000 "; then
        return 0
    else
        return 1
    fi
}

# Check if Dashboard is running
check_dashboard() {
    if pgrep -f "npm.*dev" > /dev/null || netstat -tuln 2>/dev/null | grep -q ":5173 "; then
        return 0
    else
        return 1
    fi
}

# Status command
status() {
    echo "=== JJ Bot System Status ==="
    
    # Check API with better detection
    if check_api; then
        API_PID=$(pgrep -f "uvicorn.*main:app" | head -1)
        echo -e "${GREEN}✅ API Running${NC} (PID: $API_PID)"
    else
        echo -e "${RED}❌ API Not Running${NC}"
    fi
    
    # Check Dashboard
    if check_dashboard; then
        DASH_PID=$(pgrep -f "npm.*dev" | head -1)
        echo -e "${GREEN}✅ Dashboard Running${NC} (PID: $DASH_PID)"
    else
        echo -e "${RED}❌ Dashboard Not Running${NC}"
    fi
    
    # Check API Health
    echo -n "API Health: "
    if curl -s http://127.0.0.1:8000/api/system/health > /dev/null 2>&1; then
        echo -e "${GREEN}✅ Responding${NC}"
    else
        echo -e "${RED}❌ Not Responding${NC}"
    fi
    
    # Backup info
    echo "Backups:"
    BACKUP_COUNT=$(ls -1 ~/jj-bot-backups/*/*.tar.gz 2>/dev/null | wc -l)
    LATEST_BACKUP=$(ls -t ~/jj-bot-backups/*/*.tar.gz 2>/dev/null | head -1 | xargs basename 2>/dev/null)
    echo "  Total: $BACKUP_COUNT"
    echo "  Latest: $LATEST_BACKUP"
    
    # Disk usage
    echo "Disk Usage:"
    echo "  JJ-Bot: $(du -sh ~/jj-bot 2>/dev/null | cut -f1)"
    
    # Recent logs
    if [ -f ~/jj-bot/logs/api.log ]; then
        echo "Recent API logs:"
        tail -3 ~/jj-bot/logs/api.log 2>/dev/null | sed 's/^/  /'
    fi
}

# Start command
start() {
    echo "🚀 Starting JJ Bot services..."
    
    # Start API if not running
    if ! check_api; then
        echo "Starting API..."
        cd ~/jj-bot/glue/api
        nohup uvicorn main:app --host 127.0.0.1 --port 8000 > ~/jj-bot/logs/api.log 2>&1 &
        sleep 3
    else
        echo "API already running"
    fi
    
    # Start Dashboard if not running  
    if ! check_dashboard; then
        echo "Starting Dashboard..."
        cd ~/jj-bot/dashboard/jj-dashboard
        nohup npm run dev > ~/jj-bot/logs/dashboard.log 2>&1 &
        sleep 3
    else
        echo "Dashboard already running"
    fi
    
    status
}

# Stop command
stop() {
    echo "🛑 Stopping JJ Bot services..."
    
    # Stop API
    echo "Stopping API..."
    pkill -f "uvicorn.*main:app" 2>/dev/null
    
    # Stop Dashboard
    echo "Stopping Dashboard..."
    pkill -f "npm.*dev" 2>/dev/null
    
    # Stop any simulators
    pkill -f "sim_trader.py" 2>/dev/null
    pkill -f "live_trader.py" 2>/dev/null
    
    sleep 2
    echo "✅ Services stopped"
}

# Restart command
restart() {
    stop
    sleep 2
    start
}

# Test command
test() {
    echo "=== Testing API Endpoints ==="
    endpoints=("/" "/api/config" "/api/market/prices" "/api/summary" "/api/trades" "/api/system/health")
    
    for endpoint in "${endpoints[@]}"; do
        echo -n "Testing $endpoint: "
        if curl -s "http://127.0.0.1:8000$endpoint" > /dev/null 2>&1; then
            echo -e "${GREEN}✅ OK${NC}"
        else
            echo -e "${RED}❌ Failed${NC}"
        fi
    done
}

# Trade simulator command
trade() {
    echo "🎮 Starting Trade Simulator..."
    
    if [ -f ~/jj-bot/glue/api/sim_trader.py ]; then
        cd ~/jj-bot
        python3 glue/api/sim_trader.py
    else
        echo "Trade simulator not found"
        echo "Run the fix script to create it"
    fi
}

# Live trading command
live() {
    echo -e "${YELLOW}⚠️  LIVE TRADING MODE ⚠️${NC}"
    echo "This will trade with REAL money!"
    echo -n "Are you SURE? Type 'YES' to continue: "
    read confirmation
    
    if [ "$confirmation" == "YES" ]; then
        if [ -f ~/jj-bot/hands/live/live_trader.py ]; then
            cd ~/jj-bot
            python3 hands/live/live_trader.py
        else
            echo "Live trading module not found"
            echo "Run the fix script to create it"
        fi
    else
        echo "Live trading cancelled"
    fi
}

# Reset command
reset() {
    echo "🔄 Full JJ-Bot Reset..."
    
    # Create backup
    ./backup_with_changelog.sh "Pre-reset backup"
    
    # Stop everything
    stop
    
    # Rebuild dashboard
    echo "Building dashboard..."
    cd ~/jj-bot/dashboard/jj-dashboard
    npm run build 2>/dev/null
    
    # Start everything
    cd ~/jj-bot
    start
}

# Backup command
backup() {
    ./backup_with_changelog.sh "Manual backup via jj command"
}

# Logs command
logs() {
    echo "📜 Tailing all logs (Ctrl+C to stop)..."
    tail -f ~/jj-bot/logs/*.log
}

# API logs command
api-log() {
    echo "📜 Tailing API logs (Ctrl+C to stop)..."
    tail -f ~/jj-bot/logs/api.log
}

# Dashboard logs command  
dash-log() {
    echo "📜 Tailing Dashboard logs (Ctrl+C to stop)..."
    tail -f ~/jj-bot/logs/dashboard.log
}

# Config command
config() {
    nano ~/jj-bot/config.json
}

# Menu command
menu() {
    echo "================================"
    echo "🦍 JJ-Bot Command System"
    echo "================================"
    echo "Usage: jj [command]"
    echo "Commands:"
    echo "  status    - Show system status and running processes"
    echo "  start     - Start API and Dashboard"
    echo "  stop      - Stop all JJ services"
    echo "  restart   - Restart API and Dashboard"
    echo "  logs      - Tail all logs"
    echo "  api-log   - Tail API logs only"
    echo "  dash-log  - Tail Dashboard logs only"
    echo "  backup    - Create timestamped backup"
    echo "  test      - Test all API endpoints"
    echo "  reset     - Full reset (backup, rebuild, restart)"
    echo "  trade     - Run trade simulator"
    echo "  live      - Run LIVE trading (CAUTION!)"
    echo "  config    - Edit configuration"
    echo "  menu      - Show this menu"
}

# Main command handler
case "$1" in
    status) status ;;
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    test) test ;;
    trade) trade ;;
    live) live ;;
    reset) reset ;;
    backup) backup ;;
    logs) logs ;;
    api-log) api-log ;;
    dash-log) dash-log ;;
    config) config ;;
    menu) menu ;;
    *) menu ;;
esac
