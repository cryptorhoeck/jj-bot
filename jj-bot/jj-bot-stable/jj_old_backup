#!/bin/bash

# JJ Bot CLI - Clean and Functional
# Fixed navigation and clear command execution

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Base directory
JJ_HOME=~/jj-bot
cd $JJ_HOME

# Function to show menu
show_menu() {
    echo -e "${BLUE}================================${NC}"
    echo -e "${GREEN}🦍 JJ-Bot Command System${NC}"
    echo -e "${BLUE}================================${NC}"
    echo ""
    echo "Usage: jj [command]"
    echo ""
    echo "Commands:"
    echo "  status    - Show system status and running processes"
    echo "  start     - Start API and Dashboard"
    echo "  stop      - Stop all JJ services"
    echo "  restart   - Restart API and Dashboard"
    echo "  logs      - Tail all logs"
    echo "  api-log   - Tail API logs only"
    echo "  dash-log  - Tail Dashboard logs only"
    echo "  backup    - Create timestamped backup"
    echo "  restore   - Restore from backup"
    echo "  test      - Test all API endpoints"
    echo "  reset     - Full reset (backup, rebuild, restart)"
    echo "  trade     - Run trade simulator"
    echo "  live      - Run LIVE trading (CAUTION!)"
    echo "  config    - Edit configuration"
    echo "  menu      - Show this menu"
    echo ""
    echo "Quick commands:"
    echo "  jj          - Show menu"
    echo "  jj status   - Quick status check"
    echo "  jj logs     - Quick log view"
    echo ""
}

# Function to check if services are running
check_services() {
    API_PID=$(pgrep -f "uvicorn.*glue.api.main" || echo "")
    DASH_PID=$(pgrep -f "npm.*dev" || echo "")
    
    if [ -n "$API_PID" ]; then
        echo -e "${GREEN}✅ API Running (PID: $API_PID)${NC}"
    else
        echo -e "${RED}❌ API Not Running${NC}"
    fi
    
    if [ -n "$DASH_PID" ]; then
        echo -e "${GREEN}✅ Dashboard Running${NC}"
    else
        echo -e "${RED}❌ Dashboard Not Running${NC}"
    fi
}

# Function to start services
start_services() {
    echo -e "${YELLOW}🚀 Starting JJ Bot services...${NC}"
    
    # Start API
    if ! pgrep -f "uvicorn.*glue.api.main" > /dev/null; then
        echo "Starting API..."
        source $JJ_HOME/.venv/bin/activate
        nohup python3 -m uvicorn glue.api.main:app --host 127.0.0.1 --port 8000 --reload > $JJ_HOME/logs/api.log 2>&1 &
        sleep 3
    else
        echo "API already running"
    fi
    
    # Start Dashboard
    if ! pgrep -f "npm.*dev" > /dev/null; then
        echo "Starting Dashboard..."
        cd $JJ_HOME/dashboard/jj-dashboard
        nohup npm run dev > $JJ_HOME/logs/dashboard.log 2>&1 &
        cd $JJ_HOME
        sleep 3
    else
        echo "Dashboard already running"
    fi
    
    check_services
    echo ""
    echo -e "${GREEN}Dashboard: http://localhost:5173${NC}"
    echo -e "${GREEN}API Docs: http://127.0.0.1:8000/docs${NC}"
}

# Function to stop services
stop_services() {
    echo -e "${YELLOW}🛑 Stopping JJ Bot services...${NC}"
    
    pkill -f "uvicorn.*glue.api.main" 2>/dev/null || true
    pkill -f "npm.*dev" 2>/dev/null || true
    pkill -f "vite" 2>/dev/null || true
    
    sleep 2
    echo -e "${GREEN}✅ Services stopped${NC}"
}

# Function for full reset
full_reset() {
    echo -e "${YELLOW}🔄 Full Reset Starting...${NC}"
    echo "This will:"
    echo "  1. Create backup"
    echo "  2. Stop services"
    echo "  3. Rebuild dashboard"
    echo "  4. Restart services"
    echo ""
    read -p "Continue? (y/n): " -n 1 -r
    echo ""
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        # Create backup
        echo "Creating backup..."
        TIMESTAMP=$(date +%Y%m%d_%H%M%S)
        tar -czf "$JJ_HOME/../jj-bot-backups/reset-backup-$TIMESTAMP.tar.gz" $JJ_HOME 2>/dev/null
        
        # Stop services
        stop_services
        
        # Rebuild dashboard
        echo "Rebuilding dashboard..."
        cd $JJ_HOME/dashboard/jj-dashboard
        npm install --silent
        npm run build
        
        # Restart services
        cd $JJ_HOME
        start_services
        
        echo -e "${GREEN}✅ Reset complete!${NC}"
    else
        echo "Reset cancelled"
    fi
}

# Function to show status
show_status() {
    echo -e "${BLUE}=== JJ Bot System Status ===${NC}"
    echo ""
    
    # Service status
    check_services
    echo ""
    
    # API health check
    echo -n "API Health: "
    if curl -s http://127.0.0.1:8000/ > /dev/null 2>&1; then
        echo -e "${GREEN}✅ Responding${NC}"
    else
        echo -e "${RED}❌ Not responding${NC}"
    fi
    
    # Backup info
    echo ""
    echo "Backups:"
    BACKUP_COUNT=$(ls -1 ~/jj-bot-backups/*.tar.gz 2>/dev/null | wc -l)
    LATEST_BACKUP=$(ls -t ~/jj-bot-backups/*.tar.gz 2>/dev/null | head -1 | xargs basename 2>/dev/null || echo "None")
    echo "  Total: $BACKUP_COUNT"
    echo "  Latest: $LATEST_BACKUP"
    
    # Disk usage
    echo ""
    echo "Disk Usage:"
    du -sh $JJ_HOME 2>/dev/null | awk '{print "  JJ-Bot: " $1}'
    
    # Recent logs
    echo ""
    echo "Recent API logs:"
    tail -3 $JJ_HOME/logs/api.log 2>/dev/null | sed 's/^/  /'
}

# Function to test API endpoints
test_api() {
    echo -e "${BLUE}=== Testing API Endpoints ===${NC}"
    echo ""
    
    endpoints=(
        "/"
        "/api/config"
        "/api/market/prices"
        "/api/summary"
        "/api/trades"
        "/api/system/health"
    )
    
    for endpoint in "${endpoints[@]}"; do
        echo -n "Testing $endpoint: "
        if curl -s "http://127.0.0.1:8000$endpoint" > /dev/null 2>&1; then
            echo -e "${GREEN}✅ OK${NC}"
        else
            echo -e "${RED}❌ Failed${NC}"
        fi
    done
}

# Function to create backup
create_backup() {
    echo -e "${YELLOW}📦 Creating backup...${NC}"
    cd $JJ_HOME
    if [ -f "backup_with_changelog.sh" ]; then
        ./backup_with_changelog.sh "$1"
    else
        TIMESTAMP=$(date +%Y%m%d_%H%M%S)
        BACKUP_NAME="jj-bot-backup-$TIMESTAMP.tar.gz"
        tar -czf "$JJ_HOME/../jj-bot-backups/$BACKUP_NAME" $JJ_HOME 2>/dev/null
        echo -e "${GREEN}✅ Backup created: $BACKUP_NAME${NC}"
    fi
}

# Main command handler
case "${1:-menu}" in
    status|st)
        show_status
        ;;
    start)
        start_services
        ;;
    stop)
        stop_services
        ;;
    restart)
        stop_services
        sleep 2
        start_services
        ;;
    logs|log)
        echo "Tailing all logs (Ctrl+C to stop)..."
        tail -f $JJ_HOME/logs/*.log
        ;;
    api-log)
        echo "Tailing API logs (Ctrl+C to stop)..."
        tail -f $JJ_HOME/logs/api.log
        ;;
    dash-log)
        echo "Tailing Dashboard logs (Ctrl+C to stop)..."
        tail -f $JJ_HOME/logs/dashboard.log
        ;;
    backup|bk)
        create_backup "${2:-Manual backup}"
        ;;
    restore)
        echo "Available backups:"
        ls -t ~/jj-bot-backups/*.tar.gz | head -10
        echo ""
        echo "To restore, use: tar -xzf [backup-file] -C ~/"
        ;;
    test|t)
        test_api
        ;;
    reset)
        full_reset
        ;;
    trade)
        echo -e "${YELLOW}🎮 Starting Trade Simulator...${NC}"
        source $JJ_HOME/.venv/bin/activate
        python3 $JJ_HOME/jj_trade_simulator.py 2>/dev/null || echo "Trade simulator not found"
        ;;
    live)
        echo -e "${RED}⚠️  LIVE TRADING MODE ⚠️${NC}"
        echo "This will trade with REAL money!"
        read -p "Are you SURE? Type 'YES' to continue: " -r
        if [[ $REPLY == "YES" ]]; then
            source $JJ_HOME/.venv/bin/activate
            python3 $JJ_HOME/jj_live_trading.py 2>/dev/null || echo "Live trading module not found"
        else
            echo "Live trading cancelled"
        fi
        ;;
    config)
        echo "Opening configuration..."
        nano $JJ_HOME/config.json 2>/dev/null || echo "Config file not found"
        ;;
    menu|help|h|"")
        show_menu
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo "Use 'jj menu' to see available commands"
        exit 1
        ;;
esac
