# JJ-Bot Dashboard Environment Configuration
# Copy this file to .env and customize for your environment

# API Base URL - The backend server address
# Default: http://127.0.0.1:8000 (development)
# Production example: https://your-domain.com
VITE_API_BASE=http://127.0.0.1:8000

# WebSocket URL - For real-time updates
# Default: Derived from API_BASE automatically
# Only set if different from API server
# VITE_WS_URL=ws://127.0.0.1:8000/ws

# Feature Flags (optional)
# VITE_ENABLE_DEBUG=false
# VITE_ENABLE_DEMO_MODE=true
