# JJ-Bot Environment Configuration Template
# Copy this file to .env and customize the values

# ======================
# APPLICATION SETTINGS
# ======================
APP_NAME=JJ-Bot
APP_VERSION=2.3.0
ENVIRONMENT=development  # development, staging, production

# ======================
# API CONFIGURATION
# ======================
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_RELOAD=true  # Auto-reload on code changes (dev only)

# ======================
# FRONTEND CONFIGURATION
# ======================
FRONTEND_PORT=5173
FRONTEND_HOST=localhost

# ======================
# DATABASE CONFIGURATION
# ======================
DATABASE_PATH=data/jj_trades.db
DATABASE_BACKUP_DIR=backups
DATABASE_AUTO_BACKUP=true

# ======================
# LOGGING CONFIGURATION
# ======================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text
LOG_FILE=logs/jj-bot.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true
LOG_TO_FILE=true

# ======================
# MARKET DATA CONFIGURATION
# ======================
# CoinGecko API (Free Tier)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=  # Optional: Add if using paid tier
COINGECKO_RATE_LIMIT=50  # Requests per minute (free tier: 50)
COINGECKO_TIMEOUT=10  # Request timeout in seconds

# Market data refresh interval (seconds)
MARKET_DATA_REFRESH_INTERVAL=60

# ======================
# TRADING CONFIGURATION
# ======================
# Trading mode
TRADING_MODE=paper  # paper, live

# Risk management
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=1000.0
MAX_TRADES_PER_DAY=20
COOLDOWN_SECONDS=60

# Position sizing
DEFAULT_POSITION_SIZE=100
POSITION_SIZE_METHOD=fixed  # fixed, percentage, kelly

# ======================
# STRATEGY CONFIGURATION
# ======================
# Technical indicators
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

SMA_SHORT_PERIOD=20
SMA_LONG_PERIOD=50

MACD_FAST_PERIOD=12
MACD_SLOW_PERIOD=26
MACD_SIGNAL_PERIOD=9

BOLLINGER_PERIOD=20
BOLLINGER_STD_DEV=2

# ======================
# SERVICE CONFIGURATION
# ======================
# Auto-start services on system startup
AUTO_START_SERVICES=true

# Service check interval (seconds)
SERVICE_CHECK_INTERVAL=5

# Service timeout (seconds)
SERVICE_TIMEOUT=30

# ======================
# WEBSOCKET CONFIGURATION
# ======================
WEBSOCKET_PING_INTERVAL=30  # seconds
WEBSOCKET_PING_TIMEOUT=10  # seconds
WEBSOCKET_MAX_CONNECTIONS=100

# ======================
# BACKTESTING CONFIGURATION
# ======================
BACKTEST_DEFAULT_CAPITAL=10000
BACKTEST_COMMISSION=0.001  # 0.1%
BACKTEST_SLIPPAGE=0.001  # 0.1%

# ======================
# EXCHANGE API KEYS (For Live Trading)
# ======================
# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_API_URL=https://api.kraken.com

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=
COINBASE_API_URL=https://api.coinbase.com

# ======================
# NOTIFICATION SETTINGS
# ======================
# Email notifications
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# Discord webhook
ENABLE_DISCORD_NOTIFICATIONS=false
DISCORD_WEBHOOK_URL=

# Telegram bot
ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ======================
# CACHE CONFIGURATION
# ======================
ENABLE_CACHE=false
CACHE_TYPE=memory  # memory, redis
CACHE_TTL=300  # Time to live in seconds

# Redis (if using redis cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ======================
# SECURITY SETTINGS
# ======================
# API Authentication
ENABLE_API_AUTH=false
JWT_SECRET_KEY=  # Generate with: openssl rand -hex 32
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600  # Token expiration in seconds

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Rate limiting
ENABLE_RATE_LIMITING=false
RATE_LIMIT_PER_MINUTE=60

# ======================
# MONITORING & ANALYTICS
# ======================
# Performance metrics
ENABLE_METRICS=true
METRICS_INTERVAL=60  # seconds

# Error tracking (e.g., Sentry)
ENABLE_ERROR_TRACKING=false
SENTRY_DSN=

# ======================
# AI SYSTEM CONFIGURATION
# ======================
# Anthropic Claude API (Required for AI features)
ANTHROPIC_API_KEY=  # Get from: https://console.anthropic.com/

# AI Model Settings
AI_MODEL=claude-sonnet-4-20250514  # claude-sonnet-4-20250514, claude-opus-4-20250514
AI_TEMPERATURE=0.3  # 0.0-1.0, lower = more consistent
AI_LOG_LEVEL=INFO

# AI Feature Flags
AI_ENABLE_LLM_ANALYSIS=true
AI_ENABLE_DOCUMENT_LEARNING=false  # Phase 2
AI_ENABLE_CHART_VISION=false  # Phase 3
AI_ENABLE_TIME_SERIES_ML=false  # Phase 3
AI_ENABLE_RL_AGENT=false  # Phase 4

# ======================
# FEATURE FLAGS
# ======================
ENABLE_REAL_TRADING=false
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true
ENABLE_ANALYTICS=true
ENABLE_WEBSOCKET=true
ENABLE_CSV_EXPORT=true
ENABLE_AI_ANALYSIS=true  # Master switch for AI features

# ======================
# DEVELOPMENT SETTINGS
# ======================
# Debug mode
DEBUG=true

# Hot reload
HOT_RELOAD=true

# Mock data for testing
USE_MOCK_DATA=false

# Test database
TEST_DATABASE_PATH=data/test_jj_trades.db
