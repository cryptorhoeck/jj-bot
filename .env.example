# ============================================================================
# JJ-Bot Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# Only settings that are ACTUALLY USED by the code are included here
# Version is managed in the VERSION file (not here)
# ============================================================================

# ========================
# CORE SETTINGS
# ========================
APP_NAME=JJ-Bot
ENVIRONMENT=development

# ========================
# AI CONFIGURATION (Required for AI features)
# ========================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# AI Model (claude-sonnet-4-20250514 recommended for balance of speed/quality)
AI_MODEL=claude-sonnet-4-20250514
AI_TEMPERATURE=0.3

# ========================
# EXCHANGE API KEYS (Required for live trading)
# ========================
# Kraken - Get keys from: https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ========================
# TRADING SETTINGS
# ========================
# Mode: paper (simulated) or live (real money)
TRADING_MODE=paper

# Risk Management
MAX_POSITION_SIZE=1000
MAX_DAILY_LOSS=500
INITIAL_CAPITAL=10000

# ========================
# API SERVER
# ========================
API_HOST=127.0.0.1
API_PORT=8000

# ========================
# LOGGING
# ========================
LOG_LEVEL=INFO

# ========================
# DEVELOPMENT
# ========================
DEBUG=true

# ============================================================================
# OPTIONAL SETTINGS (uncomment if needed)
# ============================================================================

# --- Database Paths (defaults work for most cases) ---
# DATABASE_PATH=data/jj_trades.db

# --- Strategy Parameters (defaults are tuned) ---
# RSI_OVERSOLD=30
# RSI_OVERBOUGHT=70

# --- Backtesting ---
# BACKTEST_DEFAULT_CAPITAL=10000
# BACKTEST_COMMISSION=0.001
# BACKTEST_SLIPPAGE=0.001

# ============================================================================
# FUTURE FEATURES (not yet implemented - for reference)
# ============================================================================

# --- Notifications (coming soon) ---
# ENABLE_DISCORD_NOTIFICATIONS=false
# DISCORD_WEBHOOK_URL=

# ENABLE_TELEGRAM_NOTIFICATIONS=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Additional Exchanges (planned) ---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# COINBASE_API_KEY=
# COINBASE_API_SECRET=
